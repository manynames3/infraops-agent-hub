# InfraOps Agent Hub example environment.
# Copy to .env for local development, or set equivalent variables in the hosted platform.
# Do not commit real secrets.

INFRAOPS_ENV=local
INFRAOPS_INTEGRATION_MODE=mock
INFRAOPS_HUMAN_APPROVAL_REQUIRED=true
INFRAOPS_ALLOW_PRODUCTION_ACTIONS=false

# Local Docker Compose Postgres. This is the default development path.
POSTGRES_DB=infraops_hub
POSTGRES_USER=infraops
POSTGRES_PASSWORD=local_infraops_password_do_not_use_in_prod
POSTGRES_PORT=5432
DATABASE_PROVIDER=local-postgres
DATABASE_URL=postgres://infraops:local_infraops_password_do_not_use_in_prod@localhost:5432/infraops_hub
DATABASE_SSL_MODE=disable

# Hosted demo persistence is disabled by default.
ENABLE_HOSTED_AUDIT_WRITES=false

# Optional Neon hosted demo database.
# Use this only in Cloudflare Pages/Workers or another hosted demo environment.
# Prefer Neon's pooled connection string for serverless/edge runtimes.
# Include sslmode=require; channel_binding=require is also acceptable when provided by Neon.
# DATABASE_PROVIDER=neon
# DATABASE_URL=postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require
# DATABASE_SSL_MODE=require
# ENABLE_HOSTED_AUDIT_WRITES=true

# n8n local development.
N8N_PORT=5678
N8N_HOST=localhost
N8N_BASIC_AUTH_USER=local-admin
N8N_BASIC_AUTH_PASSWORD=local-password-change-me
N8N_ENCRYPTION_KEY=local-only-replace-me-32-characters
GENERIC_TIMEZONE=America/New_York

ADMINER_PORT=8080

# Future integration placeholders. Keep disabled in this MVP.
ENABLE_REAL_AWS_CALLS=false
ENABLE_REAL_SLACK_CALLS=false
ENABLE_REAL_GITHUB_CALLS=false
ENABLE_REAL_LLM_CALLS=false

AWS_REGION=us-east-1
AWS_PROFILE=mock-profile-do-not-use
SLACK_WORKSPACE_ID=mock-workspace
SLACK_BOT_TOKEN=mock-token-do-not-use
GITHUB_OWNER=mock-owner
GITHUB_REPO=mock-repo
LLM_PROVIDER=mock
LLM_MODEL=mock-triage-model
