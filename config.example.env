# InfraOps Agent Hub local example configuration.
# Copy this file to .env for local use.
# Values here are placeholders for local development only.

INFRAOPS_ENV=local
INFRAOPS_INTEGRATION_MODE=mock
INFRAOPS_HUMAN_APPROVAL_REQUIRED=true
INFRAOPS_ALLOW_PRODUCTION_ACTIONS=false

POSTGRES_DB=infraops_hub
POSTGRES_USER=infraops
POSTGRES_PASSWORD=local_infraops_password_do_not_use_in_prod
POSTGRES_PORT=5432
DATABASE_URL=postgres://infraops:local_infraops_password_do_not_use_in_prod@localhost:5432/infraops_hub

N8N_PORT=5678
N8N_HOST=localhost
N8N_BASIC_AUTH_USER=local-admin
N8N_BASIC_AUTH_PASSWORD=local-password-change-me
N8N_ENCRYPTION_KEY=local-only-replace-me-32-characters
GENERIC_TIMEZONE=America/New_York

ADMINER_PORT=8080

# Future integration placeholders. Keep disabled in this MVP.
ENABLE_REAL_AWS_CALLS=false
ENABLE_REAL_SLACK_CALLS=false
ENABLE_REAL_GITHUB_CALLS=false
ENABLE_REAL_LLM_CALLS=false

AWS_REGION=us-east-1
AWS_PROFILE=mock-profile-do-not-use
SLACK_WORKSPACE_ID=mock-workspace
SLACK_BOT_TOKEN=mock-token-do-not-use
GITHUB_OWNER=mock-owner
GITHUB_REPO=mock-repo
LLM_PROVIDER=mock
LLM_MODEL=mock-triage-model
