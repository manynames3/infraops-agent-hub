    {
      "parameters": {
        "jsCode": "const alert = $input.first().json;\nconst isProduction = alert.environment === 'production';\nconst severityScore = alert.severity === 'sev1' ? 1 : alert.severity === 'sev2' ? 2 : 3;\nconst likelyCause = alert.summary.toLowerCase().includes('cpu') ? 'Sustained compute saturation or runaway request load.' : 'Unknown condition requiring operator review.';\nreturn [{\n  json: {\n    ...alert,\n    triage_mode: 'mock',\n    severity_score: severityScore,\n    likely_cause: likelyCause,\n    recommended_runbook: 'runbooks/ecs-cpu-saturation.md',\n    safe_next_steps: [\n      'Review recent deployment timeline.',\n      'Inspect read-only service metrics.',\n      'Compare sample logs against known saturation patterns.',\n      'Draft an approval request before any scaling or rollback action.'\n    ],\n    production_impacting_action: isProduction,\n    approval_required: true,\n    automation_status: 'blocked_until_human_approval'\n  }\n}];"
      },
      "id": "mock-triage",
      "name": "Mock Triage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
